  "css": "/* Blueprint: white lines on drafting blue. Light mode is a whiteprint: blue ink on white drafting paper. */:root{--bp-ink:#fff;--bp-ink2:#cfe4ff;--bp-ink3:#a9c8ee;--bp-inv:#f2f8ff;--bp-line:#e8f3ff;--bp-faint:rgb(232 243 255 / .14);--bp-mid:rgb(232 243 255 / .4);--bp-blue:#0e4a96;--bp-deep:#0a3874;--bp-mono:\"Andale Mono\",Menlo,monospace;--bp-cond:\"DIN Condensed\",\"Avenir Next Condensed\",\"Arial Narrow\",sans-serif;--bp-grid:linear-gradient(var(--bp-faint) 1px,transparent 1px) 0 0/100px 100px,linear-gradient(90deg,var(--bp-faint) 1px,transparent 1px) 0 0/100px 100px,linear-gradient(rgb(232 243 255 / .06) 1px,transparent 1px) 0 0/20px 20px,linear-gradient(90deg,rgb(232 243 255 / .06) 1px,transparent 1px) 0 0/20px 20px;--bp-spin:60s;--bp-sweep:9s;--t3-radius-composer:0;--t3-radius-bubble:0;--t3-radius-card:0;--t3-radius-control:0;--t3-composer-outline:transparent;--t3-composer-shadow:none;--t3-sidebar-inset:12px}[data-t3-part=\"app-shell\"]{background:radial-gradient(120% 100% at 50% 40%,transparent 50%,rgb(4 22 50 / .6)),var(--bp-grid),var(--bp-blue);accent-color:var(--bp-ink)}[data-t3-part=\"app-shell\"] ::selection{background:var(--bp-ink);color:var(--bp-blue)}[data-t3-part=\"main\"]{--app-theme-canvas:transparent;position:relative;isolation:isolate;overflow:hidden}[data-t3-part=\"main\"]::before{content:\"\";position:absolute;z-index:-1;left:40px;bottom:120px;width:640px;height:427px;background:var(--t3-asset-sheet) 0 0/contain no-repeat;opacity:.3;pointer-events:none}[data-t3-part=\"chat\"]{position:relative;isolation:isolate}[data-t3-part=\"chat\"]::before{content:\"\";position:absolute;z-index:-1;right:-130px;top:90px;width:520px;height:520px;background:var(--t3-asset-gear) 0 0/100% no-repeat;opacity:.38;pointer-events:none;will-change:transform;animation:bp-spin var(--bp-spin) linear infinite}[data-t3-part=\"chat\"]::after{content:\"\";position:absolute;z-index:-1;top:52px;bottom:0;left:0;width:2px;background:linear-gradient(transparent,var(--bp-ink) 30%,var(--bp-ink) 70%,transparent);box-shadow:0 0 12px #9fd0ff,0 0 2px var(--bp-ink);opacity:.55;pointer-events:none;will-change:transform;animation:bp-sweep var(--bp-sweep) ease-in-out infinite alternate}@keyframes bp-spin{to{transform:rotate(360deg)}}@keyframes bp-sweep{from{transform:translateX(20px)}to{transform:translateX(calc(100vw - 340px))}}[data-t3-part=\"chat\"][data-t3-agent=\"working\"]{--bp-spin:8s;--bp-sweep:2.2s}[data-t3-part=\"chat\"][data-t3-agent=\"working\"]::after{opacity:.9}@media (prefers-reduced-motion:reduce){[data-t3-part=\"chat\"]::before,[data-t3-part=\"chat\"]::after,[data-t3-part=\"thread-row\"][aria-current=\"page\"]::after{animation:none}}.sidebar-stage-backdrop{display:none}[data-t3-part=\"sidebar\"]{--app-theme-sidebar:transparent;counter-reset:dwg;background:var(--bp-grid),var(--bp-deep);border-right:2px solid var(--bp-line);box-shadow:inset -5px 0 0 var(--bp-deep),inset -6px 0 0 var(--bp-mid);font-family:var(--bp-cond)}[data-t3-part=\"sidebar-header\"]{border-bottom:1px solid var(--bp-mid)}[data-t3-part=\"sidebar-header\"] a,[data-t3-part=\"sidebar-header\"] a *{font:20px/1 var(--bp-cond)!important;letter-spacing:.18em;text-transform:uppercase;color:var(--bp-ink)!important}[data-t3-part=\"sidebar-search\"]{border:1px dashed var(--bp-mid);background:rgb(4 30 66 / .5)}[data-t3-part=\"sidebar-toolbar\"] *{font-family:var(--bp-mono)}[data-t3-part=\"thread-item\"]{counter-increment:dwg;padding-block:5px}[data-t3-part=\"thread-row\"]{background:rgb(6 40 86 / .55)!important;border:1px solid var(--bp-mid);box-shadow:3px 3px 0 -1px var(--bp-deep),3px 3px 0 0 var(--bp-faint)}[data-t3-part=\"thread-row\"]:hover{border-color:var(--bp-ink);background:rgb(255 255 255 / .08)!important}[data-t3-part=\"thread-body\"]{height:auto;padding:8px 10px 8px 40px}[data-t3-part=\"thread-row\"]::before{content:\"A\" counter(dwg);position:absolute;left:0;top:0;bottom:0;width:30px;display:grid;place-items:center;border-right:1px solid var(--bp-mid);font:15px var(--bp-cond);letter-spacing:.05em;color:var(--bp-ink)}[data-t3-part=\"thread-title\"]{font:17px/1.15 var(--bp-cond);letter-spacing:.06em;text-transform:uppercase;color:var(--bp-ink)!important}[data-t3-part=\"thread-status\"],[data-t3-part=\"thread-status\"] *,[data-t3-part=\"project-name\"],[data-t3-part=\"thread-meta\"]{font-family:var(--bp-mono);font-size:10px;color:var(--bp-ink3)!important;text-transform:uppercase}[data-t3-part=\"thread-row\"][aria-current=\"page\"]{background:var(--bp-inv)!important;border-color:var(--bp-ink);box-shadow:4px 4px 0 0 var(--bp-mid)}[data-t3-part=\"thread-row\"][aria-current=\"page\"] *,[data-t3-part=\"thread-row\"][aria-current=\"page\"]::before{color:var(--bp-blue)!important;border-color:var(--bp-blue)}[data-t3-part=\"thread-row\"][data-t3-agent=\"working\"]{outline:1px dashed var(--bp-ink);outline-offset:3px}[data-t3-part=\"sidebar-section-header\"]{font:15px var(--bp-cond);letter-spacing:.2em;text-transform:uppercase;color:var(--bp-ink)}[data-t3-part=\"sidebar-section-header\"] *{color:inherit!important}[data-t3-part=\"sidebar-footer\"]{border-top:1px solid var(--bp-mid)}[data-t3-part=\"chat-header\"]{background:rgb(10 56 116 / .82)!important;backdrop-filter:blur(8px);border-bottom:1px solid var(--bp-line);box-shadow:0 4px 0 -3px var(--bp-mid)}[data-t3-part=\"chat-header\"] nav,[data-t3-part=\"chat-header\"] nav *{font:19px var(--bp-cond)!important;letter-spacing:.14em;text-transform:uppercase;color:var(--bp-ink2)!important}[data-t3-part=\"chat-header\"] h2 *{color:var(--bp-ink)!important}[data-t3-part=\"chat-header\"]::after{content:\"DWG T3-0042 \\00B7  SCALE 1:1 \\00B7  REV C\";position:absolute;right:130px;top:50%;transform:translateY(-50%);font:11px var(--bp-mono);letter-spacing:.16em;color:var(--bp-ink3);pointer-events:none}[data-t3-part=\"user-message-bubble\"]{background:rgb(8 48 100 / .9)!important;border:1.5px solid var(--bp-ink);margin-right:6px;box-shadow:6px 6px 0 -2px var(--bp-blue),6px 6px 0 0 var(--bp-mid);font-family:var(--bp-mono);font-size:13px;padding-top:24px!important}[data-t3-part=\"user-message-bubble\"]::before{content:\"NOTE 1 \\2014  REQUIREMENT\";position:absolute;top:6px;left:12px;font:12px var(--bp-cond);letter-spacing:.18em;color:var(--bp-ink3)}[data-t3-part=\"assistant-message\"]{position:relative;background:rgb(10 56 116 / .9);border:1.5px solid var(--bp-ink);border-radius:0;padding:34px 22px 10px!important;line-height:1.7;box-shadow:inset 0 0 0 5px rgb(10 56 116 / .9),inset 0 0 0 6px var(--bp-mid)}[data-t3-part=\"assistant-message\"]::before{content:\"SPECIFICATION \\2014  SHEET 1 OF 1\";position:absolute;top:12px;left:22px;font:13px var(--bp-cond);letter-spacing:.2em;color:var(--bp-ink)}[data-t3-part=\"assistant-message\"]::after{content:\"\";position:absolute;top:19px;left:260px;right:22px;border-top:1px dashed var(--bp-mid)}[data-t3-part=\"assistant-message\"] :not(pre)>code{background:transparent!important;color:var(--bp-ink)!important;border:1px dashed var(--bp-ink2)!important;border-radius:0;font-family:var(--bp-mono)}[data-t3-part=\"code-block\"]{background:#082f63;border:1px solid var(--bp-mid)}[data-t3-part=\"composer\"]::before{display:none}[data-t3-part=\"composer\"]{filter:drop-shadow(0 16px 20px rgb(0 0 0 / .25))}[data-t3-part=\"composer-surface\"]{padding:0;background:rgb(8 48 100 / .94);border:1.5px solid var(--bp-ink);box-shadow:inset 0 0 0 4px rgb(8 48 100),inset 0 0 0 5px var(--bp-mid)}[data-t3-part=\"composer-context\"]{background:rgb(8 48 100 / .94);border:1px solid var(--bp-mid);font-family:var(--bp-mono)}[data-t3-part=\"composer-context\"] button{color:var(--bp-ink2)}[data-t3-part=\"composer-context\"] button:hover{color:var(--bp-ink);background:rgb(255 255 255 / .08)}[data-t3-part=\"composer\"]::after{content:\"TITLE BLOCK \\2014  INPUT\";position:absolute;z-index:30;top:-9px;left:18px;padding:0 8px;background:var(--bp-blue);font:13px/18px var(--bp-cond);letter-spacing:.2em;color:var(--bp-ink);pointer-events:none}[data-t3-part=\"composer-input\"]{--font-composer:var(--bp-mono);--font-size-prompt:13px;caret-color:var(--bp-ink)}[data-t3-part=\"composer-toolbar\"] button{font-family:var(--bp-cond);font-size:15px;letter-spacing:.08em;text-transform:uppercase}[data-t3-part=\"composer\"] button[type=\"submit\"]{border-radius:0;background:var(--bp-ink)!important;color:var(--bp-blue)!important}:root:not(.dark){--bp-ink:#0b3a7a;--bp-ink2:#1d4f92;--bp-ink3:#3d6aa6;--bp-inv:#0e4a96;--bp-line:#0e4a96;--bp-faint:rgb(14 74 150 / .12);--bp-mid:rgb(14 74 150 / .4);--bp-blue:#f5f9fe;--bp-deep:#e9f1fb}:root:not(.dark) [data-t3-part=\"app-shell\"]{background:radial-gradient(120% 100% at 50% 40%,transparent 55%,rgb(14 74 150 / .1)),var(--bp-grid),var(--bp-blue)}:root:not(.dark) [data-t3-part=\"main\"]::before,:root:not(.dark) [data-t3-part=\"chat\"]::before{filter:invert(1) hue-rotate(180deg) saturate(1.4);opacity:.22}:root:not(.dark) [data-t3-part=\"chat\"]::after{box-shadow:0 0 10px rgb(14 74 150 / .5);opacity:.35}:root:not(.dark) [data-t3-part=\"sidebar-search\"]{background:rgb(255 255 255 / .7)}:root:not(.dark) [data-t3-part=\"thread-row\"]:not([aria-current=\"page\"]){background:rgb(255 255 255 / .7)!important}:root:not(.dark) [data-t3-part=\"thread-row\"]:not([aria-current=\"page\"]):hover{background:rgb(14 74 150 / .06)!important}:root:not(.dark) [data-t3-part=\"thread-row\"][aria-current=\"page\"] *,:root:not(.dark) [data-t3-part=\"thread-row\"][aria-current=\"page\"]::before{color:#f5f9fe!important;border-color:#f5f9fe}:root:not(.dark) [data-t3-part=\"chat-header\"]{background:rgb(245 249 254 / .88)!important}:root:not(.dark) [data-t3-part=\"user-message-bubble\"]{background:rgb(255 255 255 / .92)!important}:root:not(.dark) [data-t3-part=\"assistant-message\"]{background:rgb(255 255 255 / .92);box-shadow:inset 0 0 0 5px rgb(255 255 255 / .92),inset 0 0 0 6px var(--bp-mid)}:root:not(.dark) [data-t3-part=\"code-block\"]{background:#eef4fc}:root:not(.dark) [data-t3-part=\"composer-surface\"]{background:rgb(255 255 255 / .95);box-shadow:inset 0 0 0 4px #fff,inset 0 0 0 5px var(--bp-mid)}:root:not(.dark) [data-t3-part=\"composer-context\"]{background:rgb(255 255 255 / .95)}:root:not(.dark) [data-t3-part=\"composer-context\"] button:hover{background:rgb(14 74 150 / .06)}:root:not(.dark) [data-t3-part=\"composer\"]{filter:drop-shadow(0 16px 20px rgb(14 74 150 / .12))}:root:not(.dark) [data-t3-part=\"composer\"] button[type=\"submit\"]{color:#fff!important}",
