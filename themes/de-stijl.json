  "css": "/* De Stijl: Piet Mondrian's Composition II in Red, Blue and Yellow (1930, public domain; Kunsthaus Zurich scan via Wikimedia Commons) hung in the sidebar, while black grid lines and primary planes frame the conversation. Everything is square. Light, with a night-gallery dark variant. */  :root{--t3-radius-composer:0;--t3-radius-bubble:0;--t3-radius-card:0;--t3-radius-control:0;--t3-composer-outline:transparent;--t3-composer-shadow:none;--ds-paper:#f4f1ea;--ds-white:#fbfaf6;--ds-line:#111;--ds-ink:#111;--ds-red:#d52a1e;--ds-blue:#1d3f9a;--ds-yellow:#f3c623;--ds-sans:\"Helvetica Neue\",Helvetica,Arial,sans-serif;--ds-w:8px;--ds-col:400px}:root.dark{--ds-paper:#141414;--ds-white:#1c1c1c;--ds-line:#f4f1ea;--ds-ink:#f4f1ea;--ds-red:#e8392b;--ds-blue:#2a52c4}[data-t3-part=\"app-shell\"],[data-t3-part=\"app-shell\"] *,[data-t3-part=\"app-shell\"] *::before,[data-t3-part=\"app-shell\"] *::after{border-radius:0 !important}[data-t3-part=\"app-shell\"]{font-family:var(--ds-sans);accent-color:var(--ds-red);background:var(--ds-paper)}[data-t3-part=\"main\"]{--app-theme-canvas:transparent;background:linear-gradient(var(--ds-line),var(--ds-line)) 0 0 / var(--ds-w) 100% no-repeat,linear-gradient(var(--ds-line),var(--ds-line)) calc(50% - var(--ds-col)) 0 / var(--ds-w) 100% no-repeat,linear-gradient(var(--ds-line),var(--ds-line)) calc(50% + var(--ds-col)) 0 / var(--ds-w) 100% no-repeat,linear-gradient(var(--ds-line),var(--ds-line)) 0 38% / calc(50% - var(--ds-col)) var(--ds-w) no-repeat,linear-gradient(var(--ds-line),var(--ds-line)) 0 76% / calc(50% - var(--ds-col)) var(--ds-w) no-repeat,linear-gradient(var(--ds-line),var(--ds-line)) 100% 22% / calc(50% - var(--ds-col)) var(--ds-w) no-repeat,linear-gradient(var(--ds-line),var(--ds-line)) 100% 64% / calc(50% - var(--ds-col)) var(--ds-w) no-repeat,linear-gradient(var(--ds-line),var(--ds-line)) calc(25% - var(--ds-col) / 2) 100% / var(--ds-w) 24% no-repeat,linear-gradient(var(--ds-red),var(--ds-red)) 0 0 / calc(50% - var(--ds-col)) 38% no-repeat,linear-gradient(var(--ds-yellow),var(--ds-yellow)) 0 100% / calc(25% - var(--ds-col) / 2) 24% no-repeat,linear-gradient(var(--ds-blue),var(--ds-blue)) 100% 100% / calc(50% - var(--ds-col)) calc(36% + 20% * var(--t3-context-used,0)) no-repeat,var(--ds-paper)}@media (max-width:1300px){:root{--ds-col:384px}}[data-t3-part=\"sidebar\"]{--app-theme-sidebar:transparent;background:var(--t3-asset-painting) 0 calc(100% - 40px) / 100% auto no-repeat,var(--ds-white);color:var(--ds-ink);font-family:var(--ds-sans);border-right:0 !important}.sidebar-stage-backdrop{display:none}[data-t3-part=\"sidebar\"]>div{background:transparent}[data-t3-part=\"sidebar-header\"]{background:var(--ds-yellow);box-shadow:inset 0 calc(-1 * var(--ds-w)) 0 var(--ds-line)}[data-t3-part=\"sidebar-header\"] a>span,[data-t3-part=\"sidebar-header\"] a>span *{font:800 18px/1 var(--ds-sans) !important;color:#111 !important;letter-spacing:-0.01em}[data-t3-part=\"sidebar-header\"] button,[data-t3-part=\"app-shell\"] [aria-label=\"Toggle main sidebar\"]{color:#111 !important}[data-t3-part=\"sidebar-search\"]{background:var(--ds-white);box-shadow:inset 0 0 0 3px var(--ds-line)}[data-t3-part=\"sidebar-search\"] input{font:600 14px var(--ds-sans);color:var(--ds-ink)}[data-t3-part=\"sidebar-toolbar\"]{margin-top:6px}[data-t3-part=\"sidebar-toolbar\"] button,[data-t3-part=\"sidebar-footer\"] button{color:var(--ds-ink) !important}[data-t3-part=\"sidebar-toolbar\"] button:hover,[data-t3-part=\"sidebar-footer\"] button:hover{background:var(--ds-yellow) !important;color:#111 !important}[data-t3-part=\"thread-item\"]{padding:4px 0 !important}[data-t3-part=\"thread-row\"]{background:var(--ds-white) !important;color:var(--ds-ink) !important;box-shadow:inset 0 0 0 3px var(--ds-line)}[data-t3-part=\"thread-row\"]:hover{background:var(--ds-paper) !important}[data-t3-part=\"thread-row\"][data-t3-variant=\"card\"] [data-t3-part=\"thread-body\"]{height:auto;padding:11px 13px 11px 13px;gap:3px}[data-t3-part=\"t