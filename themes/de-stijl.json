r(--ds-line)}[data-t3-part=\"chat-header\"]{background:linear-gradient(var(--ds-line),var(--ds-line)) 0 0 / var(--ds-w) 100% no-repeat,var(--ds-white) !important;box-shadow:inset 0 calc(-1 * var(--ds-w)) 0 var(--ds-line)}[data-t3-part=\"chat-header\"] nav li:last-child,[data-t3-part=\"chat-header\"] nav li:last-child *{font:800 16px var(--ds-sans);color:var(--ds-ink) !important;letter-spacing:-0.01em}[data-t3-part=\"chat-header\"] nav li:first-child button{padding:1px 8px;background:var(--ds-blue);color:#fff !important;box-shadow:inset 0 0 0 2px var(--ds-line);font:700 11px var(--ds-sans);letter-spacing:0.1em;text-transform:uppercase}[data-t3-part=\"chat-header\"] nav li:first-child button *{color:#fff !important}[data-t3-part=\"chat-header\"] button{color:var(--ds-ink) !important}[data-t3-part=\"chat-header\"]::after{content:\"\";position:absolute;right:152px;top:18px;width:52px;height:14px;pointer-events:none;background:linear-gradient(90deg,var(--ds-red) 0 14px,transparent 14px 19px,var(--ds-yellow) 19px 33px,transparent 33px 38px,var(--ds-blue) 38px)}[data-t3-part=\"transcript\"]{font-family:var(--ds-sans)}[data-t3-part=\"user-message-bubble\"]{background:var(--ds-blue) !important;color:#fff !important;box-shadow:inset 0 0 0 4px var(--ds-line);padding:14px 18px !important;font:500 15px/1.55 var(--ds-sans)}[data-t3-part=\"user-message-bubble\"] *{color:inherit !important}[data-t3-part=\"assistant-message\"]{font:15px/1.7 var(--ds-sans);color:var(--ds-ink)}[data-t3-part=\"assistant-message\"]:has(.chat-markdown){background:var(--ds-white);box-shadow:inset 0 0 0 4px var(--ds-line);padding:22px 26px 18px !important}[data-t3-part=\"assistant-message\"] strong{color:var(--ds-red)}[data-t3-part=\"assistant-message\"] :not(pre)>code{background:var(--ds-yellow) !important;color:#111 !important;border:0 !important;padding:1px 5px}[data-t3-part=\"code-block\"]{background:var(--ds-paper) !important;border:0 !important;border-left:10px solid var(--ds-line) !important;box-shadow:inset 0 0 0 3px var(--ds-line)}[data-t3-part=\"code-block\"] pre{background:transparent !important}[data-t3-part=\"composer-surface\"]{background:var(--ds-white) !important;box-shadow:inset 0 0 0 var(--ds-w) var(--ds-line) !important}[data-t3-part=\"composer-input\"]{font:500 15px var(--ds-sans);color:var(--ds-ink)}[data-t3-part=\"composer-toolbar\"]{box-shadow:inset 0 3px 0 var(--ds-line);margin:0 calc(var(--ds-w) - 1px) calc(var(--ds-w) - 1px);padding-block:11px 8px}[data-t3-part=\"composer-toolbar\"] button[data-slot]{font:700 13px var(--ds-sans);color:var(--ds-ink) !important}[data-t3-part=\"composer-toolbar\"] button[data-slot]:hover{background:var(--ds-yellow) !important;color:#111 !important}[data-t3-part=\"composer-toolbar\"] [data-slot=\"separator\"]{background:var(--ds-line);width:3px}[data-t3-part=\"composer-toolbar\"] button[aria-label=\"Submit message\"],[data-t3-part=\"composer-toolbar\"] button[aria-label=\"Send message\"]{background:var(--ds-red) !important;color:#fff !important;box-shadow:inset 0 0 0 3px var(--ds-line)}[data-t3-part=\"composer-toolbar\"] button[aria-label=\"Submit message\"]:disabled{background:var(--ds-white) !important;color:var(--ds-red) !important;opacity:1}[data-t3-part=\"composer-context\"]{background:var(--ds-yellow) !important;box-shadow:inset 0 0 0 3px var(--ds-line);color:#111 !important}[data-t3-part=\"composer-context\"] *{color:#111 !important}[data-t3-part=\"right-panel\"]{border-left:var(--ds-w) solid var(--ds-line) !important}[data-t3-part=\"terminal-drawer\"]{border-top:var(--ds-w) solid var(--ds-line) !important}[data-t3-part=\"sidebar-content\"],[data-t3-part=\"transcript\"]{scrollbar-color:var(--ds-line) transparent}@media (prefers-reduced-motion:no-preference){[data-t3-part=\"chat\"][data-t3-agent=\"working\"] [data-t3-part=\"chat-header\"]::after{animation:ds-step 2.4s steps(1) infinite}[data-t3-part=\"thread-row\"][data-t3-agent=\"working\"]{animation:ds-blink 1.6s steps(1) infinite}}@keyframes ds-step{33%