  "css": "/* Holo Foil: pastel holographic sticker foil. Dark mode is black holo foil with the same rainbow sheen. */:root{--hf-rainbow:repeating-linear-gradient(115deg,#ffb3e6 0,#a9e2ff 200px,#b8ffd6 400px,#ffeb99 600px,#d4b8ff 800px,#ffb3e6 1000px);--hf-edge:linear-gradient(120deg,#ff8fd8,#7fd8ff,#8fffc0,#ffe27a,#b48cff,#ff8fd8);--hf-ink:#2a2140;--hf-head:Futura,\"Avenir Next\",sans-serif;--hf-sans:\"Avenir Next\",\"Helvetica Neue\",sans-serif;--hf-speed:1;--t3-radius-composer:24px;--t3-radius-card:16px;--t3-radius-bubble:22px;--t3-composer-outline:transparent;--t3-composer-shadow:none}[data-t3-part=\"app-shell\"]{background:#f4ecff;accent-color:#8a5cff}[data-t3-part=\"app-shell\"] ::selection{background:#ffc6ec;color:var(--hf-ink)}[data-t3-part=\"main\"]{--app-theme-canvas:transparent;position:relative;isolation:isolate;overflow:hidden}[data-t3-part=\"main\"]::before{content:\"\";position:absolute;z-index:-1;left:-100%;top:-100%;width:300%;height:300%;background:repeating-linear-gradient(60deg,rgb(255 255 255 / .5) 0 1px,transparent 1px 46px),repeating-linear-gradient(-60deg,rgb(255 255 255 / .45) 0 1px,transparent 1px 46px),var(--hf-rainbow);pointer-events:none;will-change:transform;animation:hf-shift calc(18s / var(--hf-speed)) ease-in-out infinite alternate}@keyframes hf-shift{from{transform:translate(0,0) rotate(0)}to{transform:translate(18%,12%) rotate(4deg)}}[data-t3-part=\"main\"]::after{content:\"\\2726\";position:absolute;z-index:-1;left:22%;top:18%;font-size:30px;line-height:1;color:#fff;text-shadow:0 0 10px #fff,330px 90px 0 #fff,640px -20px 0 #fff,180px 380px 0 #fff,520px 300px 0 #fff,880px 420px 0 #fff,-120px 520px 0 #fff,760px 600px 0 #fff;pointer-events:none;animation:hf-twinkle calc(2.6s / var(--hf-speed)) ease-in-out infinite alternate}[data-t3-part=\"chat\"]{position:relative;isolation:isolate}[data-t3-part=\"chat\"]::before{content:\"\\2727\";position:absolute;z-index:-1;left:12%;top:32%;font-size:20px;line-height:1;color:#fff;text-shadow:240px -110px 0 #fff,470px 210px 0 #fff,700px 40px 0 #fff,90px 330px 0 #fff,920px 250px 0 #fff,380px 470px 0 #fff;pointer-events:none;animation:hf-twinkle calc(1.9s / var(--hf-speed)) ease-in-out -.8s infinite alternate}@keyframes hf-twinkle{from{opacity:.25;transform:scale(.7) rotate(0)}to{opacity:1;transform:scale(1.1) rotate(20deg)}}[data-t3-part=\"chat\"][data-t3-agent=\"working\"]{--hf-speed:3}@media (prefers-reduced-motion:reduce){[data-t3-part=\"main\"]::before,[data-t3-part=\"main\"]::after,[data-t3-part=\"chat\"]::before,[data-t3-part=\"thread-row\"][aria-current=\"page\"]::after,[data-t3-part=\"composer\"]::after,[data-t3-part=\"sidebar-header\"]::after{animation:none}}.sidebar-stage-backdrop{display:none}[data-t3-part=\"sidebar\"]{--app-theme-sidebar:transparent;background:linear-gradient(180deg,rgb(255 255 255 / .75),rgb(255 255 255 / .55)),var(--hf-rainbow);border-right:2px solid transparent;border-image:var(--hf-edge) 1;font-family:var(--hf-sans)}[data-t3-part=\"sidebar-header\"]{position:relative;overflow:hidden}[data-t3-part=\"sidebar-header\"] a,[data-t3-part=\"sidebar-header\"] a *{font:700 italic 20px/1 var(--hf-head)!important;letter-spacing:.02em;color:#7a4cff!important;text-shadow:1.5px 1.5px 0 #ff9ee0,-1.5px -1px 0 #7fd8ff}[data-t3-part=\"sidebar-search\"]{border-radius:999px;background:rgb(255 255 255 / .8);box-shadow:0 0 0 1.5px #e3d0ff,0 4px 12px rgb(138 92 255 / .12)}[data-t3-part=\"thread-item\"]{padding-block:6px}[data-t3-part=\"thread-row\"]{background:rgb(255 255 255 / .7)!important;box-shadow:inset 0 0 0 1px rgb(255 255 255 / .9),0 3px 6px -3px rgb(138 92 255 / .2)}[data-t3-part=\"thread-row\"]:hover{background:rgb(255 255 255 / .92)!important}[data-t3-part=\"thread-body\"]{height:auto;padding-block:8px}[data-t3-part=\"thread-title\"]{font:600 14px/1.3 var(--hf-sans);color:var(--hf-ink)!important}[data-t3-part=\"thread-status\"],[data-t3-part=\"thread-status\"] *,[data-t3-part=\"project-name\"],[data-t3-part=\"thread-meta\"]{color:#7a6fa0!important}[data-t3-part=\"thread-row\"][aria-current=\"page\"]{overflow:hidden;background:var(--hf-rainbow)!important;background-size:200% 200%!important;box-shadow:inset 0 0 0 1.5px #c9a8ff,inset 0 0 0 3.5px #fff,0 3px 6px -3px rgb(138 92 255 / .5)}[data-t3-part=\"thread-row\"][aria-current=\"page\"]::after{content:\"\";position:absolute;inset:-20% auto -20% 0;width:45%;background:linear-gradient(100deg,transparent,rgb(255 255 255 / .85) 50%,transparent);pointer-events:none;animation:hf-sheen calc(3.4s / var(--hf-speed)) ease-in-out infinite}@keyframes hf-sheen{0%{transform:translateX(-120%) skewX(-18deg)}60%,100%{transform:translateX(330%) skewX(-18deg)}}[data-t3-part=\"thread-row\"][data-t3-agent=\"working\"]{--hf-speed:3}[data-t3-part=\"sidebar-section-header\"]{font:700 italic 13px var(--hf-head);letter-spacing:.1em;text-transform:uppercase;color:#8a5cff}[data-t3-part=\"sidebar-section-header\"] *{color:inherit!important}[data-t3-part=\"chat-header\"]{background:rgb(255 255 255 / .55)!important;backdrop-filter:blur(18px) saturate(1.4);border-bottom:1.5px solid rgb(255 255 255 / .9);box-shadow:0 1px 0 #e3d0ff}[data-t3-part=\"chat-header\"] nav,[data-t3-part=\"chat-header\"] nav *{font-family:var(--hf-head)!important;font-size:15px}[data-t3-part=\"chat-header\"] h2 *{font-weight:700;font-style:italic;color:#6a3fe0!important}[data-t3-part=\"transcript\"]{font-family:var(--hf-sans)}[data-t3-part=\"user-message-bubble\"]{background:linear-gradient(135deg,#ffd6f2,#d6efff 50%,#e9dcff)!important;color:var(--hf-ink)!important;border-radius:22px 22px 6px 22px!important;box-shadow:inset 0 0 0 1px #e8c8ff,inset 0 0 0 3px #fff,0 8px 16px -8px rgb(255 120 210 / .45)}[data-t3-part=\"user-message-bubble\"] *{color:var(--hf-ink)!important}[data-t3-part=\"assistant-message\"]{background:rgb(255 255 255 / .88);border-radius:24px;padding:20px 22px 8px!important;box-shadow:inset 0 0 0 1.5px #dcc8ff,inset 0 0 0 3.5px rgb(255 255 255 / .95),0 8px 16px -8px rgb(120 90 220 / .3);line-he