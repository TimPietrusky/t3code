-t3-part=\"thread-row\"]:not([aria-current=\"page\"]){background:rgb(255 255 255 / .06)!important;box-shadow:inset 0 0 0 1px rgb(255 255 255 / .1),0 3px 6px -3px rgb(0 0 0 / .45)}:root.dark [data-t3-part=\"thread-row\"]:not([aria-current=\"page\"]):hover{background:rgb(255 255 255 / .11)!important}:root.dark :is([data-t3-part=\"thread-status\"],[data-t3-part=\"thread-status\"] *,[data-t3-part=\"project-name\"],[data-t3-part=\"thread-meta\"]){color:#b9addc!important}:root.dark [data-t3-part=\"thread-row\"][aria-current=\"page\"]{box-shadow:inset 0 0 0 1.5px #a985ff,inset 0 0 0 3.5px #120e1e,0 3px 6px -3px rgb(138 92 255 / .55)}:root.dark [data-t3-part=\"thread-row\"][aria-current=\"page\"]::after{background:linear-gradient(100deg,transparent,rgb(255 255 255 / .28) 50%,transparent)}:root.dark [data-t3-part=\"sidebar-section-header\"]{color:#bba0ff}:root.dark [data-t3-part=\"chat-header\"]{background:rgb(18 14 30 / .62)!important;border-bottom-color:rgb(255 255 255 / .12);box-shadow:0 1px 0 rgb(169 133 255 / .3)}:root.dark [data-t3-part=\"chat-header\"] h2 *{color:#cdb6ff!important}:root.dark [data-t3-part=\"user-message-bubble\"]{background:linear-gradient(135deg,#4a2148,#1b3a54 50%,#33275c)!important;box-shadow:inset 0 0 0 1px #7a5aa8,inset 0 0 0 3px #120e1e,0 8px 16px -8px rgb(255 120 210 / .3)}:root.dark [data-t3-part=\"assistant-message\"]{background:rgb(24 18 40 / .9);box-shadow:inset 0 0 0 1.5px rgb(169 133 255 / .45),inset 0 0 0 3.5px rgb(255 255 255 / .06),0 8px 16px -8px rgb(0 0 0 / .6)}:root.dark [data-t3-part=\"assistant-message\"] :not(pre)>code{background:linear-gradient(90deg,#3a1a3c,#18304a)!important;color:#dcc8ff!important;border-color:#4a3a70!important}:root.dark [data-t3-part=\"code-block\"]{background:#171226;border-color:#3a2d5c}:root.dark [data-t3-part=\"composer-surface\"]{background:#181228;border-color:rgb(255 255 255 / .1);box-shadow:0 0 0 1.5px rgb(169 133 255 / .5)}:root.dark [data-t3-part=\"composer-context\"]{background:rgb(24 18 40 / .8)